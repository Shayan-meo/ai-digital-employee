# Cloud Environment Configuration
# Copy to .env and fill in values (NEVER commit .env to Git)

# === Cloud VM Settings ===
CLOUD_AGENT_ID=cloud_001
VAULT_SYNC_ENABLED=true
SYNC_INTERVAL=60

# === Gmail API (Cloud - Draft Only) ===
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8080/callback

# === Social Media APIs (Cloud - Draft Only) ===
LINKEDIN_API_KEY=your_linkedin_api_key
LINKEDIN_API_SECRET=your_linkedin_api_secret
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# === Odoo (Cloud - Draft Only) ===
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=your_odoo_password

# === Logging ===
LOG_LEVEL=INFO
LOG_TO_FILE=true

# === Security ===
DRY_RUN=false
MAX_DRAFTS_PER_HOUR=50
APPROVAL_REQUIRED=true
