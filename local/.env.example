# Local Environment Configuration
# Copy to .env and fill in values (NEVER commit .env to Git)
# CRITICAL: This file NEVER syncs to Cloud VM

# === Local Agent Settings ===
LOCAL_AGENT_ID=local_001
APPROVAL_WATCHER_ENABLED=true
CHECK_INTERVAL=30

# === WhatsApp Session (Local Only - NEVER Sync) ===
WHATSAPP_SESSION_PATH=D:/AI_Employee_Vault/.whatsapp_session
WHATSAPP_STATE_PATH=D:/AI_Employee_Vault/.whatsapp_state.json

# === Banking Credentials (Local Only - NEVER Sync) ===
BANK_API_URL=your_bank_api_url
BANK_API_KEY=your_bank_api_key
BANK_USERNAME=your_bank_username
BANK_PASSWORD=your_bank_password

# === Odoo MCP (Local - Final Approval) ===
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=your_odoo_password

# === MCP Servers (Local) ===
GMAIL_MCP_ENABLED=true
GMAIL_OAUTH_PATH=D:/AI_Employee_Vault/gmail_credentials/client_secret.json

LINKEDIN_MCP_ENABLED=true
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# === Social Media Playwright (Local - Final Post) ===
FACEBOOK_SESSION_PATH=D:/AI_Employee_Vault/.facebook_session
INSTAGRAM_SESSION_PATH=D:/AI_Employee_Vault/.instagram_session
TWITTER_SESSION_PATH=D:/AI_Employee_Vault/.twitter_session
LINKEDIN_SESSION_PATH=D:/AI_Employee_Vault/.linkedin_session

# === Logging ===
LOG_LEVEL=INFO
LOG_TO_FILE=true
AUDIT_ALL_ACTIONS=true

# === Security ===
DRY_RUN=false
MAX_PAYMENTS_PER_DAY=10
REQUIRE_2FA_FOR_PAYMENTS=true
